# SkillSentry Configuration

# Host and Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Model Inference Configuration
# Modes: "local" (e.g. Ollama), "hosted" (OpenAI-compatible / vLLM / Groq), or "offline" (deterministic only)
MODEL_INFERENCE_MODE=offline
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MODEL_ENDPOINT=http://localhost:11434/v1
MODEL_API_KEY=""

# Storage
STORAGE_DIR=./data/scans
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
